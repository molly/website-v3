{# The site header: the wordmark, one row of the main pages, and the Menu button, with the Menu
   below them. The pages are in _data/siteNav.js, which says which links drop out at which widths
   and which top-level page is underlined for a page that isn't in the bar. The dynamic site's
   pug/templates/includes/siteHeader.pug and siteMenu.pug have the same markup. #}
{% set nav = siteNav.navState(page.url.split("/")[1] or "home") %}

{% macro menuLink(link, current) %}
  {% set here = link.key and link.key == current %}
  <a href="{{ link.href }}"{% if link.italic or link.me %} class="u-url{% if here %} site-menu-here{% endif %}"{% elif here %} class="site-menu-here"{% endif %}{% if link.me %} rel="me"{% endif %}{% if here %} aria-current="page"{% endif %}>{% if link.italic %}<i>{{ link.text }}</i>{% else %}{{ link.text }}{% endif %}</a>
  {%- if here %}<span class="site-menu-here-note"> · you’re here</span>{% endif %}
{% endmacro %}

<header class="site-header" data-nosnippet>
  <div class="site-header-bar">
    <a class="site-wordmark-small" href="/">Molly White</a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {% for link in siteNav.bar %}
        <li{% if link.from %} class="site-nav-from-{{ link.from }}"{% endif %}>
          <a href="{{ link.href }}"{% if nav.current == link.key %} aria-current="page"{% endif %}{% if nav.parent == link.key %} class="site-nav-parent site-nav-parent-{{ nav.parentFrom }}"{% endif %}>{{ link.text }}</a>
        </li>
        {% endfor %}
        <li>
          <button id="site-menu-button" class="site-menu-button" type="button" aria-expanded="false" aria-controls="site-menu">
            <span class="site-menu-button-closed"><svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M1 3h10M1 6h10M1 9h10" stroke="currentColor" stroke-width="1.3"/></svg> Menu</span>
            <span class="site-menu-button-open"><svg viewBox="0 0 12 12" width="9" height="9" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.5"/></svg> Close</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
  {# The Menu: every page, opened by the Menu button, pushing the page down #}
  <div id="site-menu" class="site-menu" hidden>
    {% for group in siteNav.menu %}
    <ul class="site-menu-group">
      {% for top in group %}
      <li class="site-menu-top">
        {{ menuLink(top, nav.current) }}
        {% if top.children %}
        <ul class="site-menu-children">
          {% for child in top.children %}
          <li>{{ menuLink(child, nav.current) }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endfor %}
  </div>
</header>
