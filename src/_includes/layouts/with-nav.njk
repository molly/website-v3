{% extends "layouts/base.njk" %}

{# Pages with the site header: the redesign's styles, header and Menu (the dynamic site's
   pug/templates/includes/siteHeader.pug and siteMenu.pug have the same markup). #}
{% block stylesheet %}<link rel="stylesheet" href="/assets/styles/site-styles.css" />{% endblock %}

{% block pagecontent %}
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-page">
    {% include "nav.njk" %}
    <main id="main" class="site-main {{page_class}}">
      {% block content %}{% endblock %}
    </main>
  </div>
{% endblock %}

{% block js %}
  <script src="/assets/js/site-menu.js"></script>
{% endblock %}
