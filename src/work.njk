] %}

{% extends "layouts/with-nav.njk" %}
{% block content %}

<header class="work-head">
  <h1 class="work-title">Work</h1>
</header>

<section aria-labelledby="work-projects-heading">
  <h2 id="work-projects-heading" class="work-section-heading">Publications and projects</h2>
  <ul class="work-cards">
    {% for project in projects %}
    <li class="work-card">
      <p class="work-card-label">{{ project.label }}</p>
      <h3 class="work-card-title"><a class="u-url" href="{{ project.href }}"><i>{{ project.title }}</i></a></h3>
      <p class="work-card-description">{{ project.description }}</p>
      <p class="work-card-link"><a href="{{ project.href }}">{{ project.linkText }} →</a></p>
    </li>
    {% endfor %}
  </ul>
</section>

<section class="work-elsewhere" aria-labelledby="work-elsewhere-heading">
  <h2 id="work-elsewhere-heading" class="work-section-heading">Writing, speaking, and press</h2>
  <ul class="work-rows">
    {% for item in elsewhere %}
    <li class="work-row">
      <a class="work-row-title" href="{{ item.href }}">{{ item.title }} <span aria-hidden="true">→</span></a>
      <p class="work-row-description">{{ item.description | safe }}</p>
    </li>
    {% endfor %}
  </ul>
</section>

{% endblock %}
