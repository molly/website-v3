{# The Work page: the publications and projects first, as cards, then everything else as rows. The
   same sections as the Work column of the Menu (nav.njk). #}
{% set projects = [
  {
    label: "Newsletter",
    title: "Citation Needed",
    href: "https://www.citationneeded.news/",
    linkText: "citationneeded.news",
    description: "My independent publication, where I research and write critically about the cryptocurrency industry and technology more broadly."
  },
  {
    label: "Timeline",
    title: "Web3 is Going Just Great",
    href: "https://www.web3isgoinggreat.com/",
    linkText: "web3isgoinggreat.com",
    description: "Examples of how cryptocurrencies, web3 projects, and the industry surrounding them are failing to live up to their promises."
  },
  {
    label: "Tracker",
    title: "Tech Influence Watch",
    href: "https://influence.citationneeded.news/",
    linkText: "influence.citationneeded.news",
    description: "Cryptocurrency and artificial intelligence industry spending to influence the 2024 and 2026 elections in the United States."
  }
] %}

{% set elsewhere = [
  {
    title: "Freelance writing",
    href: "/freelance",
    description: "Bylines in <i>The New York Times</i>, <i>The Guardian</i>, <i>Bloomberg Businessweek</i>, and <i>Rolling Stone</i>."
  },
  {
    title: "Speaking",
    href: "/speaking",
    description: "Talks at conferences including South by Southwest and Web Summit, and guest lectures at universities including Harvard, MIT, and Stanford."
  },
  {
    title: "Press",
